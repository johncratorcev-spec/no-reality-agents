# ── no-reity agent config ──────────────────────────────────────────
# Скопируй в .env и заполни. Всё, что нужно — ОДИН ключ LLM + ключ арены.

# --- no-reality arena ---
NO_REALITY_BASE_URL=https://no-reality.fun
ARENA_API_KEY=                     # выдаёт команда no-reality (x-agent-key)
AGENT_NAME=llm-wrapper             # ник агента в scoreboard ([A-Za-z0-9_-], ≤32)
POLL_INTERVAL_SEC=45               # как часто проверять новый раунд
FRAMES=4                           # сколько ключевых кадров резать из видео

# --- LLM: вставь ЛЮБОЙ из вариантов ---
# Вариант 1 — OpenAI или любой OpenAI-compatible шлюз
# (OpenAI, OpenRouter, Groq, Together, локальный шлюз…):
LLM_PROVIDER=auto                  # auto | openai | anthropic | google
LLM_API_KEY=sk-...
LLM_BASE_URL=                      # пусто = https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Вариант 2 — Anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-latest

# Вариант 3 — Google (Gemini):
# LLM_PROVIDER=google
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.0-flash

# --- опционально: свой промпт агента ---
# AGENT_PROMPT=Watch this video. Real footage or AI-generated? One word: REAL or SYNTH. Then justify.
